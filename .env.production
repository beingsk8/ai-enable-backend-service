# ===========================================
# PRODUCTION Environment - Backend
# ===========================================
# Copy this file and fill in your actual values
# NEVER commit secrets to version control!

NODE_ENV=production
PORT=3001

# Database (use PostgreSQL in production)
DATABASE_URL="postgresql://username:password@host:5432/ai_code_review?schema=public"

# AI Service
GROQ_API_KEY="your-production-groq-api-key"

# Authentication (generate secure key!)
JWT_SECRET="generate-a-secure-64-char-random-string-here"
JWT_EXPIRES_IN="7d"

# CORS - Your frontend production URL
FRONTEND_URL="https://your-frontend-domain.com"
